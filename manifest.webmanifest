{
  "name": "MyWeather",
  "short_name": "MyWeather",
  "description": "Weather for Chennai and Tamil Nadu: radar, rain, forecasts, warnings and cyclones.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12161b",
